# Password checked by /api/stats to gate the /admin analytics dashboard.
ADMIN_PASSWORD=

# Redis store used to hold visitor counters. Create a Redis database from the
# Vercel Marketplace (Storage tab) and connect it to this project, then
# `vercel env pull` to get real values locally. Either naming below works —
# api/_redis.js checks both.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
