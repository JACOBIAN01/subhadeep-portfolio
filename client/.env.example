# Password checked by /api/stats to gate the /admin analytics dashboard.
ADMIN_PASSWORD=

# Redis connection string used to hold visitor counters. Created via the
# Vercel Marketplace "Redis" integration (Storage tab) connected with the
# "KV" prefix, which injects KV_REDIS_URL. Run `vercel env pull` to get the
# real value locally.
KV_REDIS_URL=
